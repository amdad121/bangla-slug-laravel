{
    "name": "amdadulhaq/bangla-slug-laravel",
    "description": "Readable Banglish URL slugs from Bangla text for Laravel: phonetic transliteration, English loanword and acronym detection.",
    "keywords": [
        "Amdadul Haq",
        "laravel",
        "bangla-slug-laravel",
        "slug",
        "bangla",
        "bengali",
        "banglish",
        "transliteration"
    ],
    "homepage": "https://github.com/amdad121/bangla-slug-laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Amdadul Haq",
            "email": "amdadulhaq781@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amdad121/bangla-slug-laravel/issues",
        "source": "https://github.com/amdad121/bangla-slug-laravel"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/amdad121"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AmdadulHaq\\BanglaSlug\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmdadulHaq\\BanglaSlug\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmdadulHaq\\BanglaSlug\\BanglaSlugServiceProvider"
            ],
            "aliases": {
                "BanglaSlug": "AmdadulHaq\\BanglaSlug\\Facades\\BanglaSlug"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
